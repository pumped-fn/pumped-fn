{
  "name": "@pumped-fn/pumped",
  "version": "1.0.1",
  "private": false,
  "description": "Convention-driven scope compiler: declare entries with tags, assemble a scope, mount them on HTTP, CLI, cron, and workflow hosts",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.cts",
  "bin": {
    "pumped": "./dist/cli.mjs"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "peerDependencies": {
    "@hono/node-server": "^2.0.0",
    "@pumped-fn/lite": "^6.5.0",
    "@pumped-fn/lite-extension-scheduler": "^1.0.0",
    "hono": "^4.12.0"
  },
  "peerDependenciesMeta": {
    "@hono/node-server": {
      "optional": true
    },
    "@pumped-fn/lite-extension-scheduler": {
      "optional": true
    },
    "hono": {
      "optional": true
    }
  },
  "dependencies": {
    "@pumped-fn/lite-hmr": "workspace:*",
    "cac": "catalog:",
    "vite": "catalog:"
  },
  "devDependencies": {
    "@hono/node-server": "catalog:",
    "@pumped-fn/lite": "workspace:*",
    "@pumped-fn/lite-extension-scheduler": "catalog:",
    "@pumped-fn/lite-lint": "workspace:*",
    "@types/node": "catalog:",
    "acorn": "catalog:",
    "hono": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "typescript-api": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "pumped-fn",
    "lite",
    "framework",
    "cli",
    "vite",
    "dependency-injection"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "directory": "pkg/framework/pumped",
    "url": "git+https://github.com/pumped-fn/pumped-fn.git"
  }
}
