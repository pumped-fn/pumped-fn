{
  "name": "@pumped-fn/pumped-tour",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node ../../pkg/framework/pumped/dist/cli.mjs build --target all",
    "build:east": "node ../../pkg/framework/pumped/dist/cli.mjs build --app east --target all",
    "dev": "node ../../pkg/framework/pumped/dist/cli.mjs dev",
    "dev:east": "node ../../pkg/framework/pumped/dist/cli.mjs dev --app east",
    "graph": "node ../../pkg/framework/pumped/dist/cli.mjs graph",
    "graph:east": "node ../../pkg/framework/pumped/dist/cli.mjs graph --app east",
    "server": "node dist/server.mjs",
    "server:east": "node dist/apps/east/server.mjs",
    "cli": "node dist/cli.mjs",
    "cli:east": "node dist/apps/east/cli.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "check": "node ../../pkg/framework/pumped/dist/cli.mjs check"
  },
  "dependencies": {
    "@hono/node-server": "catalog:",
    "@pumped-fn/lite": "workspace:*",
    "@pumped-fn/lite-extension-scheduler": "catalog:",
    "@pumped-fn/pumped": "workspace:*",
    "hono": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
