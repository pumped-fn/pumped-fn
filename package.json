{
  "name": "pumped-fn-monorepo",
  "private": true,
  "packageManager": "pnpm@10.33.4",
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm -r --workspace-concurrency=2 test",
    "typecheck": "pnpm -r typecheck",
    "typecheck:full": "pnpm -r typecheck:full",
    "verify": "pnpm build && pnpm test && pnpm typecheck && pnpm typecheck:full && pnpm published-types:check && pnpm packed-lite:check",
    "lint": "pnpm -F @pumped-fn/lite-lint build && pumped-lite-lint --config pumped-lite-lint.json README.md docs scripts packages/*/README.md packages/*/src packages/lite/PATTERNS.md packages/lite/MIGRATION.md packages/lite/tests packages/lite-logging/tests packages/lite-logging-pino/tests packages/lite-observability/tests packages/lite-observability-otel/tests && pnpm alignment:check",
    "lint:check": "pnpm lint",
    "alignment:check": "node scripts/check-repository-alignment.mjs",
    "alignment:test": "node --test scripts/check-repository-alignment.test.mjs scripts/check-changed-packages.test.mjs",
    "actionlint": "github-actionlint .github/workflows/*.yml",
    "act": "node scripts/act.mjs",
    "actions:check": "pnpm actionlint && pnpm act -l",
    "changeset": "changeset",
    "changeset:version": "changeset version",
    "changeset:publish": "pnpm build && changeset publish",
    "changeset:status": "changeset status --verbose",
    "release-policy:check": "node scripts/check-release-policy.mjs",
    "release-policy:test": "node --test scripts/check-release-policy.test.mjs",
    "release": "pnpm verify && pnpm changeset:publish",
    "ci:changed-packages": "node scripts/check-changed-packages.mjs",
    "contract:check": "node scripts/check-public-contract.mjs",
    "contract:test": "node --test scripts/check-public-contract.test.mjs",
    "inline-exec:check": "node scripts/check-inline-exec-contract.mjs",
    "inline-exec:test": "node --test scripts/check-inline-exec-contract.test.mjs",
    "packed-lite:check": "pnpm -r build && node scripts/check-packed-lite.mjs",
    "published-types:check": "node scripts/check-published-types.mjs",
    "test:ci": "pnpm act -W .github/workflows/ci.yml -j test",
    "test:release": "pnpm act -W .github/workflows/release.yml -j release --secret-file .secrets",
    "perf:quick": "node benchmarks/lite-perf/scripts/quick.mjs"
  },
  "devDependencies": {
    "@changesets/cli": "catalog:",
    "@pumped-fn/lite-lint": "workspace:*",
    "github-actionlint": "catalog:",
    "typescript": "catalog:",
    "typescript-api": "catalog:"
  },
  "license": "MIT"
}
